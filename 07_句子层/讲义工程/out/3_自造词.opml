<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
<head><title>三、自造词</title></head>
<body>
  <outline text="三、自造词">
    <outline text="三.1 总量和原则"/>
    <outline text="三.2 七个位置">
      <outline text="三.2 位置1 位置一：标题"/>
      <outline text="三.2 位置2 位置二：开头"/>
      <outline text="三.2 位置3 位置三：标签句后半句"/>
      <outline text="三.2 位置4 位置四：道理句"/>
      <outline text="三.2 位置5 位置五：长句里的连接词和转换动词"/>
      <outline text="三.2 位置6 位置六：收束句的句框"/>
      <outline text="三.2 位置7 位置七：结尾的起头句、点名、落点"/>
    </outline>
    <outline text="三.3 要理解才能写的地方：只问三个问题">
      <outline text="三.3 问一 问一：它对总目标是什么角色"/>
      <outline text="三.3 问二 问二：没有它会怎样"/>
      <outline text="三.3 问三 问三：人们常把它想窄成什么"/>
      <outline text="三.3 机构 另两种写法：依据式和反面式"/>
    </outline>
    <outline text="三.4 要积累的成套东西">
      <outline text="三.4① 胶水词">
        <outline text="三.4① 让 胶水词：让"/>
        <outline text="三.4① 以 胶水词：以"/>
        <outline text="三.4① 把 胶水词：把"/>
        <outline text="三.4① 才能 胶水词：才能"/>
        <outline text="三.4① 才有 胶水词：才有"/>
        <outline text="三.4① 其余 其余胶水词"/>
      </outline>
      <outline text="三.4② 角色名词配动词"/>
      <outline text="三.4③ 标签前半句的动词"/>
      <outline text="三.4④ 策论「要」后面的转换动词"/>
      <outline text="三.4⑤ 写问题的一套"/>
      <outline text="三.4⑥ 结尾用词"/>
      <outline text="三.4⑦ 句框"/>
      <outline text="三.4⑧ 其他小件"/>
      <outline text="三.4⑨ 不背的东西"/>
    </outline>
  </outline>
</body>
</opml>
