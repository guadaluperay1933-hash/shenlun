  <outline text="七、整合">
    <outline text="七.1 交卷前四查">
      <outline text="七.1 第一查 第一查：引号里的字和材料一字不差吗"/>
      <outline text="七.1 第二查 第二查：开头点的难后文接了吗"/>
      <outline text="七.1 第三查 第三查：广东当主语的句子谓语都是正面的吗"/>
